<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
  <title>PRÉSIDENT + QUIZ SIONISTE + INTERROGATION</title>
  <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Share+Tech+Mono&display=swap" rel="stylesheet">
  <style>
    /* ============================================================
       STYLES GLOBAUX (identiques aux jeux 1 et 2)
       ============================================================ */
    :root {
      --bg-dark: #020304;
      --crt-border: #151a17;
      --crt-bg: #060908;
      --color-mil: #ef4444;
      --color-cit: #f97316;
      --color-arg: #eab308;
      --color-san: #14b8a6;
      --color-mor: #a78bfa;
      --font-pixel: 'Press Start 2P', monospace;
      --font-mono: 'Share Tech Mono', monospace;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; user-select: none; }
    html, body {
      width: 100%; min-height: 100vh;
      background: var(--bg-dark);
      color: #e2e8f0;
      font-family: var(--font-pixel);
      display: flex; justify-content: center; align-items: center;
      padding: 10px; overflow-x: hidden;
    }
    ::-webkit-scrollbar { width: 4px; }
    ::-webkit-scrollbar-track { background: #0a0c0e; }
    ::-webkit-scrollbar-thumb { background: var(--color-mil); border-radius: 2px; }

    .nav-bar {
      position: fixed; top: 10px; left: 50%; transform: translateX(-50%);
      display: flex; flex-wrap: wrap; gap: 6px; z-index: 100;
      background: rgba(2,3,4,0.92); padding: 6px 12px; border-radius: 14px;
      border: 2px solid #1e293b;
      backdrop-filter: blur(4px);
      box-shadow: 0 4px 30px rgba(0,0,0,0.8);
    }
    .nav-btn {
      background: #1a1d20; border: 2px solid var(--color-mil);
      color: #fff; font-family: var(--font-pixel); font-size: 0.45rem;
      padding: 5px 10px; cursor: pointer; border-radius: 6px;
      box-shadow: 0 3px 0 #050607; transition: all 0.15s ease;
    }
    .nav-btn:hover { background: #3b1111; transform: translateY(-2px); }
    .nav-btn.active {
      background: var(--color-mil); border-color: #fff;
      box-shadow: 0 0 20px rgba(239,68,68,0.3), 0 3px 0 #7f1d1d;
    }
    @media (max-width: 700px) { .nav-btn { font-size: 0.35rem; padding: 4px 6px; } }

    .bunker-outer-wrapper {
      position: relative;
      width: 100%; max-width: 1280px;
      background: radial-gradient(circle at center, #2b3036 0%, #111417 70%, #050607 100%);
      border: 12px solid #1a1d20;
      border-radius: 32px;
      box-shadow: inset 0 0 80px rgba(0,0,0,0.98), 0 30px 80px rgba(0,0,0,0.99);
      padding: 18px;
      display: flex;
      flex-direction: column;
      margin-top: 70px;
      min-height: 85vh;
    }

    .game-container { display: none; flex-direction: column; height: 100%; animation: fadeIn 0.5s ease; }
    .game-container.active { display: flex; }
    @keyframes fadeIn { 0% { opacity:0; transform:scale(0.97); } 100% { opacity:1; transform:scale(1); } }

    .crt-screen-container {
      flex:1; background: var(--crt-bg);
      border:6px solid var(--crt-border);
      border-radius:20px; position:relative; overflow:hidden;
      display:flex; flex-direction:column; justify-content:flex-start;
      padding:15px; box-shadow:inset 0 0 80px rgba(0,0,0,1);
      margin-bottom:12px;
      min-height: 380px;
    }
    .crt-screen-container::before {
      content:""; display:block; position:absolute; top:0;left:0;bottom:0;right:0;
      background: linear-gradient(rgba(18,16,16,0) 50%, rgba(0,0,0,0.35) 50%),
                  linear-gradient(90deg, rgba(255,0,0,0.02), rgba(0,255,0,0.01), rgba(0,0,255,0.02));
      z-index:20; background-size:100% 4px, 6px 100%; pointer-events:none;
      animation: scanlineMove 8s linear infinite;
    }
    @keyframes scanlineMove { 0% { background-position: 0 0, 0 0; } 100% { background-position: 0 100%, 0 0; } }

    .header-panel { position:relative; z-index:5; text-align:center; border-bottom:3px double #1c241f; padding-bottom:8px; margin-bottom:8px; }
    .main-title { font-size:1rem; color:var(--color-mil); letter-spacing:2px; text-shadow:0 0 12px rgba(239,68,68,0.5); }
    .sub-title { font-size:0.45rem; color:var(--color-arg); margin-top:4px; font-family:var(--font-mono); }

    .dialogue-card {
      position:relative; z-index:5; background:#0b100d;
      border:3px solid var(--color-mil); border-radius:10px;
      padding:10px; display:flex; gap:10px; align-items:center;
      box-shadow:0 4px 20px rgba(0,0,0,0.9); min-height:110px; margin-bottom:12px;
    }
    .pnj-portrait-box {
      width:70px; height:70px; background:#000; border:2px solid var(--color-mil);
      border-radius:6px; overflow:hidden; flex-shrink:0;
      display: flex; align-items: center; justify-content: center;
    }
    .pnj-portrait-box canvas { width:100%; height:100%; image-rendering:pixelated; }
    .speaker-title { color:var(--color-mil); margin-bottom:4px; font-size:0.55rem; }
    .speech-bubble { color:#cbd5e1; font-size:0.6rem; line-height:1.6; }

    .choices-container {
      position:relative; z-index:5; display:flex; flex-direction:column;
      gap:6px; margin-top:6px;
    }
    .choice-button {
      background:#120606; border:2px solid #3b1111; border-radius:6px;
      color:#fca5a5;
      font-family: var(--font-mono);
      font-size: 0.7rem;
      padding: 10px 16px;
      cursor: pointer;
      transition: all 0.15s ease;
      box-shadow: 0 3px 0 #050706;
      text-align: left;
      line-height: 1.4;
    }
    .choice-button:hover { background:#230808; border-color:var(--color-mil); color:#fff; transform:translateX(6px); }
    .choice-button:active { transform:translateY(3px); box-shadow:0 1px 0 #050706; }
    .choice-button:disabled { opacity:0.4; cursor:not-allowed; transform:none !important; }

    .bottom-dashboard {
      background:#080b0c; border:4px solid var(--crt-border); border-radius:12px;
      padding:10px 12px; display:flex; flex-direction:column; gap:6px;
      box-shadow:inset 0 0 30px rgba(0,0,0,0.95);
    }
    .gauges-labels-row {
      display:grid; grid-template-columns:repeat(5,1fr); gap:6px; text-align:center;
    }
    .gauge-card-item { display:flex; flex-direction:column; align-items:center; gap:2px; background:rgba(0,0,0,0.5); padding:4px; border-radius:6px; border:1px solid #1e293b; }
    .gauge-labels { display:flex; justify-content:space-between; width:100%; font-size:0.3rem; color:#94a3b8; font-family:var(--font-mono); }
    .gauge-horizontal-container { width:100%; height:12px; background:#020405; border:2px solid #131916; border-radius:4px; overflow:hidden; }
    .gauge-fill-bar { height:100%; transition:width 0.6s cubic-bezier(0.34, 1.56, 0.64, 1); }
    .fill-militaire { background: linear-gradient(to right, #7f1d1d, #ef4444); }
    .fill-peuple    { background: linear-gradient(to right, #78350f, #f97316); }
    .fill-tresor    { background: linear-gradient(to right, #713f12, #eab308); }
    .fill-sante     { background: linear-gradient(to right, #064e3b, #14b8a6); }
    .fill-morale    { background: linear-gradient(to right, #4c1d95, #a78bfa); }
    .gauge-value { font-size:0.4rem; color:#cbd5e1; }

    .game-over-overlay {
      position:absolute; top:0; left:0; right:0; bottom:0;
      background:rgba(3,7,18,0.97); z-index:50; display:none;
      flex-direction:column; align-items:center; justify-content:center;
      padding:20px; text-align:center; animation: fadeIn 0.5s ease;
    }
    .game-over-title { color:var(--color-mil); font-size:1.2rem; text-shadow:0 0 30px red; }
    .game-over-desc { color:#94a3b8; font-size:0.7rem; margin:8px 0; max-width:500px; }
    .btn-restart {
      padding:10px 20px; background:var(--color-mil); color:#fff; border:none;
      font-family:var(--font-pixel); font-size:0.55rem; cursor:pointer;
      border-radius:6px; box-shadow:0 4px 0 #7f1d1d; margin:4px;
      transition:all 0.15s;
    }
    .btn-restart:hover { background:#f87171; transform:translateY(-2px); box-shadow:0 6px 0 #7f1d1d; }
    .btn-restart:active { transform:translateY(4px); box-shadow:0 2px 0 #7f1d1d; }

    .particle-container {
      position:absolute; top:0; left:0; width:100%; height:100%; pointer-events:none; z-index:15; overflow:hidden;
    }
    .particle {
      position:absolute; width:4px; height:4px; background:var(--color-mil); border-radius:50%;
      animation: particleFloat 3s ease-out forwards; opacity:0.8;
    }
    @keyframes particleFloat {
      0% { transform:translateY(0) scale(1); opacity:0.8; }
      100% { transform:translateY(-120px) scale(0); opacity:0; }
    }
    .history-log-container { background:#020617; padding:8px; max-height:120px; overflow-y:auto; font-size:0.4rem; color:#64748b; margin-bottom:10px; width:90%; border-radius:6px; text-align:left; }

    .status-bar {
      display:flex; justify-content:space-between; flex-wrap:wrap; gap:4px;
      background:rgba(15,23,42,0.9); border:2px solid #1e293b; border-radius:6px;
      padding:6px; margin-bottom:8px;
    }
    .status-item { font-size:0.45rem; }
    .status-item .label { color:#94a3b8; }
    .status-item .value { color:#fbbf24; }

    /* ============================================================
       STYLES SPÉCIFIQUES AU JEU 2 (SIONISTE)
       ============================================================ */
    .sioniste-choices {
      display:flex; flex-wrap:wrap; gap:8px; justify-content:center; margin:10px 0;
    }
    .sioniste-choices .choice-button {
      flex:1; min-width:120px; text-align:center;
    }
    .sioniste-choices .choice-button.correct {
      border-color: #14b8a6; background:#064e3b; color:#fff;
    }
    .sioniste-choices .choice-button.wrong {
      border-color: #ef4444; background:#7f1d1d; color:#fff;
    }
    .sioniste-portrait {
      width:120px; height:120px; border-radius:8px; border:2px solid var(--color-mil);
      object-fit:cover; background:#000; margin:0 auto 10px;
      image-rendering:pixelated;
    }
    .sioniste-name { font-size:0.8rem; color:var(--color-mil); text-align:center; margin-bottom:6px; }
    .sioniste-proof { background:#0b100d; border:2px solid var(--color-arg); border-radius:6px; padding:10px; font-size:0.55rem; color:#cbd5e1; margin:8px 0; text-align:center; min-height:50px; display:none; }
    .sioniste-progress { font-size:0.5rem; color:#94a3b8; text-align:center; margin:4px 0; }

    /* ============================================================
       STYLES SPÉCIFIQUES AU JEU 3 (INTERROGATION)
       ============================================================ */
    .interro-suspect-card {
      background:#0b100d; border:2px solid var(--color-san); border-radius:8px;
      padding:12px; margin:6px 0; display:flex; gap:15px; align-items:center;
      flex-wrap:wrap;
    }
    .interro-suspect-card .portrait-box {
      width:70px; height:70px; background:#000; border:2px solid var(--color-san);
      border-radius:6px; overflow:hidden; flex-shrink:0;
      display: flex; align-items: center; justify-content: center;
    }
    .interro-suspect-card .portrait-box canvas { width:100%; height:100%; image-rendering:pixelated; }
    .interro-suspect-info { flex:1; }
    .interro-suspect-info .name { color:var(--color-san); font-size:0.7rem; }
    .interro-suspect-info .desc { color:#94a3b8; font-size:0.45rem; margin-top:4px; }

    .interro-preview {
      background:#0b100d; border:2px solid var(--color-arg); border-radius:6px;
      padding:10px; margin:6px 0; font-size:0.5rem; color:#fbbf24;
      text-align:center; line-height:1.5;
    }
    .interro-preview .crime { color:#ef4444; font-weight:bold; }
    .interro-preview .victim { color:#f97316; }
    .interro-preview .reproche { color:#94a3b8; }

    .interro-question-area { margin:6px 0; width:100%; }
    .interro-question-area .q { color:#cbd5e1; font-size:0.55rem; }
    .interro-question-area .a { color:#fbbf24; font-size:0.5rem; font-style:italic; margin-top:4px; }

    .interro-input-area { display:flex; gap:8px; margin:6px 0; flex-wrap:wrap; }
    .interro-input-area input {
      flex:1; min-width:150px; padding:8px 12px; background:#0b100d; border:2px solid #1e293b;
      border-radius:6px; color:#e2e8f0; font-family:var(--font-mono); font-size:0.55rem;
      outline:none; transition:border 0.3s;
    }
    .interro-input-area input:focus { border-color:var(--color-san); }
    .interro-input-area input:disabled { opacity:0.4; cursor:not-allowed; }
    .interro-input-area .choice-button { padding:8px 16px; font-size:0.55rem; }

    .interro-questions-log { margin:4px 0; max-height:80px; overflow-y:auto; }
    .interro-questions-log .entry { font-size:0.4rem; color:#94a3b8; padding:2px 0; border-bottom:1px solid #131916; }
    .interro-questions-log .entry .q { color:#cbd5e1; }
    .interro-questions-log .entry .a { color:#fbbf24; font-style:italic; }

    .interro-actions { display:flex; gap:10px; flex-wrap:wrap; justify-content:center; margin:8px 0; }
    .interro-actions .choice-button { flex:1; min-width:100px; text-align:center; }
    .interro-actions .choice-button.btn-prison { border-color:var(--color-mil); }
    .interro-actions .choice-button.btn-release { border-color:var(--color-san); }

    .interro-progress { font-size:0.45rem; color:#94a3b8; text-align:center; margin:4px 0; }
    .interro-feedback { background:#0b100d; border:2px solid var(--color-arg); border-radius:6px; padding:10px; font-size:0.5rem; color:#fbbf24; margin:6px 0; text-align:center; min-height:40px; display:none; }

    @media (max-width:800px){
      .gauges-labels-row { grid-template-columns:1fr 1fr 1fr; }
      .main-title { font-size:0.7rem; }
      .nav-btn { font-size:0.3rem; padding:3px 5px; }
      .dialogue-card { flex-direction:column; align-items:stretch; }
      .pnj-portrait-box { width:50px; height:50px; align-self:center; }
      .choice-button { font-size:0.55rem; padding:8px 12px; }
      .sioniste-portrait { width:90px; height:90px; }
      .interro-suspect-card .portrait-box { width:50px; height:50px; }
      .status-item { font-size:0.35rem; }
      .interro-input-area input { font-size:0.45rem; padding:6px 10px; }
    }
  </style>
</head>
<body>

<!-- ===== NAVIGATION ===== -->
<div class="nav-bar">
  <button class="nav-btn active" id="nav-dictator" onclick="switchGame('dictator')">PRÉSIDENT</button>
  <button class="nav-btn" id="nav-sioniste" onclick="switchGame('sioniste')">SIONISTE</button>
  <button class="nav-btn" id="nav-interrogation" onclick="switchGame('interrogation')">INTERRO</button>
</div>

<!-- ===== BUNKER ===== -->
<div class="bunker-outer-wrapper">

  <!-- ==================== JEU 1 : PRÉSIDENT (VERROUILLÉ) ==================== -->
  <div class="game-container active" id="game-dictator">
    <div class="crt-screen-container">
      <div class="particle-container" id="particle-container-dictator"></div>
      <div class="header-panel">
        <h1 class="main-title" id="president-title">PRÉSIDENT — ÉDITION POLITIQUE</h1>
        <div class="sub-title">DES VRAIES QUESTIONS — DES VRAIES RÉPONSES — DES IMPACTS LOGIQUES</div>
      </div>
      <div class="status-bar">
        <span class="status-item"><span class="label">ANNÉE</span> <span class="value" id="ui-year">1</span></span>
        <span class="status-item"><span class="label">STATUT</span> <span class="value" id="ui-status">STABLE</span></span>
        <span class="status-item"><span class="label">SCORE</span> <span class="value" id="ui-score">0</span></span>
        <span class="status-item"><span class="label">SUPER</span> <span class="value" id="ui-super">5 tours</span></span>
        <span class="status-item"><span class="label">MORALE</span> <span class="value" id="ui-morale-label">50%</span></span>
      </div>
      <div class="dialogue-card">
        <div class="pnj-portrait-box"><canvas id="caricatureCanvas" width="70" height="70"></canvas></div>
        <div class="dialogue-text-box" style="flex:1;">
          <div class="speaker-title" id="ui-speaker" style="color:var(--color-mil);">CONSEILLER</div>
          <p class="speech-bubble" id="ui-speech">Chargement...</p>
          <div class="timer-bar-container" id="timerContainer" style="display:none;">
            <div class="timer-bar-fill" id="timerBar" style="width:100%;"></div>
          </div>
        </div>
      </div>
      <div class="choices-container" id="ui-choices"></div>
      <div class="game-over-overlay" id="ui-game-over">
        <h2 class="game-over-title" id="go-title">FIN DE PARTIE</h2>
        <p class="game-over-desc" id="go-desc">...</p>
        <div style="display:flex; gap:10px; flex-wrap:wrap; justify-content:center; margin:8px 0;">
          <button class="btn-restart" onclick="PresidentEngine.acceptDefeat()">ABANDONNER</button>
          <button class="btn-restart" style="background:#dc2626;" onclick="PresidentEngine.embraceTyranny()">DEVENIR TYRAN</button>
        </div>
        <div class="history-log-container" id="go-log"></div>
        <button class="btn-restart" onclick="PresidentEngine.restart()">RECOMMENCER</button>
      </div>
    </div>
    <div class="bottom-dashboard">
      <div class="gauges-labels-row">
        <div class="gauge-card-item"><span>🪖 MILITAIRE</span><div class="gauge-labels"><span>RÉPRESSION</span><span>DÉFENSE</span></div><div class="gauge-horizontal-container"><div class="gauge-fill-bar fill-militaire" id="bar-mil" style="width:60%"></div></div><span class="gauge-value" id="val-mil">60%</span></div>
        <div class="gauge-card-item"><span>👥 PEUPLE</span><div class="gauge-labels"><span>MÉFIANCE</span><span>CONFIANCE</span></div><div class="gauge-horizontal-container"><div class="gauge-fill-bar fill-peuple" id="bar-cit" style="width:60%"></div></div><span class="gauge-value" id="val-cit">60%</span></div>
        <div class="gauge-card-item"><span>💰 TRÉSOR</span><div class="gauge-labels"><span>RUINE</span><span>PROSPÉRITÉ</span></div><div class="gauge-horizontal-container"><div class="gauge-fill-bar fill-tresor" id="bar-arg" style="width:60%"></div></div><span class="gauge-value" id="val-arg">60%</span></div>
        <div class="gauge-card-item"><span>🏥 SANTÉ</span><div class="gauge-labels"><span>CHARLATAN</span><span>SCIENCE</span></div><div class="gauge-horizontal-container"><div class="gauge-fill-bar fill-sante" id="bar-san" style="width:60%"></div></div><span class="gauge-value" id="val-san">60%</span></div>
        <div class="gauge-card-item"><span>⚖️ MORALE</span><div class="gauge-labels"><span>CORRUPTION</span><span>INTÉGRITÉ</span></div><div class="gauge-horizontal-container"><div class="gauge-fill-bar fill-morale" id="bar-mor" style="width:50%"></div></div><span class="gauge-value" id="val-mor">50%</span></div>
      </div>
    </div>
  </div>

  <!-- ==================== JEU 2 : QUIZ SIONISTE ==================== -->
  <div class="game-container" id="game-sioniste">
    <div class="crt-screen-container" style="align-items:center; justify-content:flex-start;">
      <div class="header-panel" style="width:100%;">
        <h1 class="main-title" style="color:var(--color-san);">▐ QUIZ SIONISTE</h1>
        <div class="sub-title">SIONISTE — NEUTRE — ANTISIONISTE</div>
      </div>
      <div class="status-bar" style="width:100%;">
        <span class="status-item"><span class="label">QUESTION</span> <span class="value" id="sio-question">1/30</span></span>
        <span class="status-item"><span class="label">BONNES</span> <span class="value" id="sio-score">0</span></span>
        <span class="status-item"><span class="label">STATUT</span> <span class="value" id="sio-status">EN COURS</span></span>
      </div>
      <div style="text-align:center; width:100%;">
        <img id="sio-portrait" class="sioniste-portrait" src="" alt="Portrait">
        <div class="sioniste-name" id="sio-name">Nom de la célébrité</div>
      </div>
      <div class="sioniste-proof" id="sio-proof">Preuve ici…</div>
      <div class="sioniste-choices" id="sio-choices">
        <button class="choice-button" data-value="sioniste" onclick="SionisteGame.answer('sioniste')">🇮🇱 SIONISTE</button>
        <button class="choice-button" data-value="neutre" onclick="SionisteGame.answer('neutre')">⚖️ NEUTRE</button>
        <button class="choice-button" data-value="antisioniste" onclick="SionisteGame.answer('antisioniste')">🇵🇸 ANTISIONISTE</button>
      </div>
      <button class="btn-restart" id="sio-next" style="display:none; margin:8px 0;" onclick="SionisteGame.next()">QUESTION SUIVANTE ▶</button>
      <div class="game-over-overlay" id="sio-gameover">
        <h2 class="game-over-title" id="sio-go-title">FIN DU QUIZ</h2>
        <p class="game-over-desc" id="sio-go-desc">...</p>
        <div style="display:flex; gap:10px; flex-wrap:wrap; justify-content:center; margin:8px 0;">
          <button class="btn-restart" onclick="SionisteGame.restart()">RECOMMENCER</button>
        </div>
        <div class="history-log-container" id="sio-go-log"></div>
      </div>
      <div class="sioniste-progress" id="sio-progress">▪ ▪ ▪ ▪ ▪ ▪ ▪ ▪ ▪ ▪ ▪ ▪ ▪ ▪ ▪ ▪ ▪ ▪ ▪ ▪ ▪ ▪ ▪ ▪ ▪ ▪ ▪ ▪ ▪ ▪</div>
    </div>
  </div>

  <!-- ==================== JEU 3 : INTERROGATION (AVEC PREVIEW FACTUELLE) ==================== -->
  <div class="game-container" id="game-interrogation">
    <div class="crt-screen-container" style="align-items:center; justify-content:flex-start;">
      <div class="header-panel" style="width:100%;">
        <h1 class="main-title" style="color:var(--color-arg);">▐ INTERROGATION</h1>
        <div class="sub-title">5 QUESTIONS — UN CRIME — UNE DÉCISION</div>
      </div>

      <div class="status-bar" style="width:100%;">
