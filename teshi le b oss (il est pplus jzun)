//  CARICATURE 2D (pour le jeu 1)
// ============================================================
function drawCaricature(canvasId, name, mood=0){
  const canvas=document.getElementById(canvasId); if(!canvas) return;
  const ctx=canvas.getContext('2d'); const w=canvas.width,h=canvas.height;
  ctx.clearRect(0,0,w,h); ctx.fillStyle='#0a0c0e'; ctx.fillRect(0,0,w,h);
  let seed=0; for(let i=0;i<name.length;i++) seed+=name.charCodeAt(i);
  const rng=(max)=>Math.floor((seed*9301+49297)%233280/233280*max);
  const random=(min,max)=>rng(max-min+1)+min;
  const cx=w/2, cy=h/2, radius=28+random(-4,4);
  ctx.fillStyle='#d4a373'; ctx.strokeStyle='#333'; ctx.lineWidth=2;
  ctx.beginPath(); ctx.arc(cx,cy,radius,0,2*Math.PI); ctx.fill(); ctx.stroke();
  const eyeY=cy-6+random(-2,2), eyeSpacing=14+random(-2,2), eyeSize=5+random(0,2);
  ctx.fillStyle='#222';
  ctx.fillRect(cx-eyeSpacing-eyeSize/2, eyeY-eyeSize/2, eyeSize, eyeSize);
  ctx.fillRect(cx+eyeSpacing-eyeSize/2, eyeY-eyeSize/2, eyeSize, eyeSize);
  ctx.fillStyle='#fff';
  ctx.fillRect(cx-eyeSpacing-eyeSize/2+1, eyeY-eyeSize/2+1, 2, 2);
  ctx.fillRect(cx+eyeSpacing-eyeSize/2+1, eyeY-eyeSize/2+1, 2, 2);
  ctx.fillStyle='#b08968'; ctx.fillRect(cx-2, cy+2, 4, 6); ctx.fillRect(cx-1, cy+6, 2, 2);
  ctx.fillStyle='#222'; const mouthY=cy+14+random(-2,2);
  if(mood< -30){ ctx.fillRect(cx-8, mouthY, 4,2); ctx.fillRect(cx-6, mouthY-2,2,2); ctx.fillRect(cx-10, mouthY-2,2,2); }
  else if(mood>30){ ctx.fillRect(cx+4, mouthY, 4,2); ctx.fillRect(cx+4, mouthY-2,2,2); ctx.fillRect(cx+8, mouthY-2,2,2); }
  else { ctx.fillRect(cx-6, mouthY, 12,2); }
  if(random(0,3)===0){ ctx.fillStyle='#1e293b'; ctx.fillRect(cx-18, cy-30, 36,8); ctx.fillRect(cx-12, cy-34, 24,6); }
  else if(random(0,3)===1){ ctx.fillStyle='#b91c1c'; ctx.beginPath(); ctx.ellipse(cx,cy-28,22,12,0,0,Math.PI*2); ctx.fill(); ctx.fillRect(cx-6,cy-36,12,6); }
}

// ============================================================
//  CARICATURE 2D POUR LES SUSPECTS (jeu 3)
// ============================================================
function drawSuspectCaricature(canvasId, name, age, job, guilty){
  const canvas=document.getElementById(canvasId); if(!canvas) return;
  const ctx=canvas.getContext('2d'); const w=canvas.width,h=canvas.height;
  ctx.clearRect(0,0,w,h); ctx.fillStyle='#0a0c0e'; ctx.fillRect(0,0,w,h);
  let seed=0; for(let i=0;i<name.length;i++) seed+=name.charCodeAt(i);
  seed += age * 7 + (guilty ? 13 : 0);
  const rng=(max)=>Math.floor((seed*9301+49297)%233280/233280*max);
  const random=(min,max)=>rng(max-min+1)+min;
  const cx=w/2, cy=h/2, radius=26+random(-3,3);
  const skinTones = ['#d4a373','#c9a87c','#b8956a','#e0b68c','#cfa87a'];
  ctx.fillStyle=skinTones[random(0,skinTones.length-1)];
  ctx.strokeStyle='#333'; ctx.lineWidth=2;
  ctx.beginPath(); ctx.arc(cx,cy,radius,0,2*Math.PI); ctx.fill(); ctx.stroke();
  const eyeY=cy-5+random(-2,2), eyeSpacing=13+random(-2,2), eyeSize=4+random(0,2);
  ctx.fillStyle='#222';
  ctx.fillRect(cx-eyeSpacing-eyeSize/2, eyeY-eyeSize/2, eyeSize, eyeSize);
  ctx.fillRect(cx+eyeSpacing-eyeSize/2, eyeY-eyeSize/2, eyeSize, eyeSize);
  ctx.fillStyle='#fff';
  ctx.fillRect(cx-eyeSpacing-eyeSize/2+1, eyeY-eyeSize/2+1, 2, 2);
  ctx.fillRect(cx+eyeSpacing-eyeSize/2+1, eyeY-eyeSize/2+1, 2, 2);
  ctx.fillStyle='#b08968'; ctx.fillRect(cx-2, cy+2, 4, 5); ctx.fillRect(cx-1, cy+5, 2, 2);
  const mouthY=cy+13+random(-2,2);
  ctx.fillStyle='#222';
  if(guilty){
    ctx.fillRect(cx-4, mouthY, 3,2); ctx.fillRect(cx+1, mouthY, 3,2);
    ctx.fillRect(cx-2, mouthY-2, 4,2);
  }else{
    ctx.fillRect(cx-5, mouthY, 10,2);
  }
  const jobLower = job.toLowerCase();
  if(jobLower.includes('police')||jobLower.includes('militaire')||jobLower.includes('armée')){ ctx.fillStyle='#1e293b'; ctx.fillRect(cx-14, cy-28, 28,6); ctx.fillRect(cx-8, cy-32, 16,5); }
  else if(jobLower.includes('juge')||jobLower.includes('avocat')){ ctx.fillStyle='#222'; ctx.fillRect(cx-8, cy-30, 16,4); }
  else if(jobLower.includes('informaticien')||jobLower.includes('technicien')){ ctx.fillStyle='#3b82f6'; ctx.fillRect(cx-10, cy-28, 20,4); }
  else if(jobLower.includes('artiste')||jobLower.includes('musicien')){ ctx.fillStyle='#8b5cf6'; ctx.beginPath(); ctx.arc(cx, cy-30, 12, 0, Math.PI*2); ctx.fill(); }
  if(guilty){ ctx.fillStyle='#ef4444'; ctx.fillRect(cx+20, cy-22, 5,5); }
}

