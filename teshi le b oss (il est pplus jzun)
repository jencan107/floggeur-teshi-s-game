        reproche: "A vendu des secrets diplomatiques. Des transactions financières suspectes ont été identifiées."
      }
    },
    { 
      name: "Thomas Leroy", age: 51, job: "Agriculteur", items: "Tracteur, outils", guilty: false,
      accusation: {
        crime: "Incendie volontaire",
        victime: "Granges municipales",
        reproche: "Présent sur les lieux. Les experts ont conclu à un départ de feu accidentel. Aucun accélérateur trouvé."
      }
    },
    { 
      name: "Anna Kowalski", age: 37, job: "Ingénieure", items: "Plans de centrale, clé de sécurité", guilty: true,
      accusation: {
        crime: "Sabotage",
        victime: "Centrale nucléaire",
        reproche: "A désactivé les systèmes de sécurité. Des contacts avec un groupe extrémiste ont été découverts."
      }
    },
    { 
      name: "Pierre Dupont", age: 42, job: "Commerçant", items: "Carnet de comptes, reçus", guilty: false,
      accusation: {
        crime: "Vol",
        victime: "Bijouterie",
        reproche: "Présent dans la rue au moment du vol. Les caméras de sa boutique confirment sa présence à ce moment."
      }
    },
    { 
      name: "Maria Santos", age: 33, job: "Infirmière", items: "Blouse, ordonnances", guilty: false,
      accusation: {
        crime: "Meurtre",
        victime: "Patient",
        reproche: "A administré un médicament. L'autopsie a conclu à une cause naturelle. Aucune négligence constatée."
      }
    },
    { 
      name: "Dmitri Sokolov", age: 48, job: "Chauffeur", items: "GPS, carte de transport", guilty: true,
      accusation: {
        crime: "Meurtre",
        victime: "Politicien",
        reproche: "Chauffeur de la victime. Son GPS montre un trajet inhabituel le jour du crime. Il a modifié son itinéraire."
      }
    },
    { 
      name: "Julie Lefèvre", age: 26, job: "Graphiste", items: "Tablette graphique, portfolio", guilty: false,
      accusation: {
        crime: "Vol",
        victime: "Galerie d'art",
        reproche: "Présente pour une commande. Aucun intérêt pour le vol. Son téléphone la localise ailleurs au moment des faits."
      }
    },
    { 
      name: "Ahmed Benali", age: 39, job: "Cuisinier", items: "Couteaux de cuisine, tablier", guilty: false,
      accusation: {
        crime: "Meurtre",
        victime: "Client",
        reproche: "A préparé le repas. Le client est mort d'une allergie non déclarée. Aucune trace de substance toxique."
      }
    },
    { 
      name: "Carlos Garcia", age: 44, job: "Musicien", items: "Guitare, partitions", guilty: true,
      accusation: {
        crime: "Vol",
        victime: "Orchestre",
        reproche: "A volé des partitions anciennes. Des témoins l'ont vu sortir avec un objet sous le bras."
      }
    },
    { 
      name: "Svetlana Petrova", age: 31, job: "Banquière", items: "Dossiers financiers, clé USB", guilty: true,
      accusation: {
        crime: "Fraude",
        victime: "Investisseurs",
        reproche: "A détourné des millions vers des comptes offshores. Des anomalies comptables ont été détectées."
      }
    }
  ];

  // ===== ÉTAT =====
  let state = {
    suspects: [],
    currentIndex: 0,
    total: 15,
    score: 0,
    questionCount: 0,
    maxQuestions: 5,
    suspectAnswered: false,
    gameOver: false,
    history: [],
    currentSuspect: null,
    log: []
  };

  // ===== UI =====
  const ui = {
    num: document.getElementById('interro-num'),
    qcount: document.getElementById('interro-qcount'),
    score: document.getElementById('interro-score'),
    status: document.getElementById('interro-status'),
    name: document.getElementById('interro-name'),
    desc: document.getElementById('interro-desc'),
    qText: document.getElementById('interro-q-text'),
    aText: document.getElementById('interro-a-text'),
    input: document.getElementById('interro-input'),
    btnAsk: document.getElementById('interro-btn-ask'),
    log: document.getElementById('interro-log'),
    feedback: document.getElementById('interro-feedback'),
    progress: document.getElementById('interro-progress'),
    nextBtn: document.getElementById('interro-next'),
    btnPrison: document.getElementById('interro-btn-prison'),
    btnRelease: document.getElementById('interro-btn-release'),
    gameOver: document.getElementById('interro-gameover'),
    goTitle: document.getElementById('interro-go-title'),
    goDesc: document.getElementById('interro-go-desc'),
    goLog: document.getElementById('interro-go-log'),
    canvas: document.getElementById('interroCanvas'),
    crimeType: document.getElementById('interro-crime-type'),
    victim: document.getElementById('interro-victim'),
    previewText: document.getElementById('interro-preview-text')
  };

  // ===== MÉLANGE =====
  function shuffle(array){ for (let i = array.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [array[i], array[j]] = [array[j], array[i]]; } return array; }

  // ===== PRÉPARER =====
  function prepareSuspects(){
    const shuffled = shuffle([...suspects]);
    state.suspects = shuffled.slice(0, state.total);
    state.currentIndex = 0;
    state.score = 0;
    state.gameOver = false;
    state.history = [];
    state.log = [];
    state.currentSuspect = null;
  }

  // ===== GÉNÉRER UNE RÉPONSE HUMAINE =====
  function generateAnswer(guilty, question, crimeType, victim){
    const qLower = question.toLowerCase();
    
    // Réponses spécifiques pour les innocents
    const innocentResponses = [
      `Je suis désolé, mais je n'ai rien à voir avec le ${crimeType || 'crime'} de ${victim || 'la victime'}.`,
      `Je comprends votre suspicion, mais j'ai un alibi solide pour ce jour-là.`,
      `Je ne connais même pas ${victim || 'cette personne'}. Pourquoi serais-je impliqué ?`,
      `Je peux vous donner les coordonnées de témoins qui confirmeront ma présence ailleurs.`,
      `Je n'ai jamais mis les pieds sur les lieux du ${crimeType || 'crime'}.`
    ];

    // Réponses spécifiques pour les coupables
    const guiltyResponses = [
      `Je ne vais pas vous mentir, j'étais sur les lieux, mais je n'ai rien fait de mal.`,
      `Je connaissais la victime, c'est vrai, mais ce n'est pas une raison pour m'accuser.`,
      `J'ai des choses à cacher, mais ce n'est pas ce que vous croyez.`,
      `Je ne peux pas tout vous dire, mais je vous jure que je ne suis pas le coupable.`,
      `Vous voulez savoir la vérité ? Vous n'êtes pas prêt à l'entendre.`,
      `J'ai un alibi, mais je ne peux pas le révéler pour protéger quelqu'un.`,
      `J'étais là, mais j'étais pas le seul. Pourquoi moi ?`,
      `Je regrette certaines de mes actions, mais pas celle-ci.`
    ];

    // Sélectionner une réponse en fonction de la culpabilité
    let response = guilty ? 
      guiltyResponses[Math.floor(Math.random() * guiltyResponses.length)] :
      innocentResponses[Math.floor(Math.random() * innocentResponses.length)];

    // Ajouter un indice subtil si coupable (toujours, mais pas trop évident)
    if (guilty && Math.random() < 0.3) {
      response += " Mais j'ai peut-être des choses à vous dire si vous me posez les bonnes questions.";
    }

    return response;
  }

  // ===== AFFICHER UN SUSPECT =====
  function displaySuspect(){
    if (state.currentIndex >= state.suspects.length || state.gameOver) {
      endGame();
      return;
    }

    state.currentSuspect = state.suspects[state.currentIndex];
    state.questionCount = 0;
    state.suspectAnswered = false;
    state.log = [];

    // Afficher la preview FACTUELLE (uniquement l'accusation)
    const acc = state.currentSuspect.accusation;
    ui.crimeType.textContent = acc.crime;
    ui.victim.textContent = acc.victime;
    ui.previewText.textContent = `Accusé de ${acc.crime} — ${acc.reproche}`;

    // Infos du suspect
    ui.name.textContent = state.currentSuspect.name;
    ui.desc.textContent = `Âge: ${state.currentSuspect.age} | Profession: ${state.currentSuspect.job} | Objets: ${state.currentSuspect.items}`;
    ui.qText.textContent = "Posez votre question ci-dessous.";
    ui.aText.textContent = "";
    ui.feedback.style.display = 'none';
    ui.feedback.textContent = '';
    ui.nextBtn.style.display = 'none';
    ui.log.innerHTML = '';
    ui.input.value = '';
    ui.input.disabled = false;
    ui.btnAsk.disabled = false;
    ui.btnPrison.disabled = false;
    ui.btnRelease.disabled = false;

    // Dessiner la caricature
    drawSuspectCaricature('interroCanvas', state.currentSuspect.name, state.currentSuspect.age, state.currentSuspect.job, state.currentSuspect.guilty);

    // Compteurs
    ui.num.textContent = `${state.currentIndex + 1}/${state.suspects.length}`;
    ui.qcount.textContent = `0/${state.maxQuestions}`;
    ui.score.textContent = state.score;
    ui.status.textContent = 'INTERROGATION';

    // Progress bar
    let progress = '';
    for (let i = 0; i < state.suspects.length; i++) {
      if (i < state.currentIndex) {
        const hist = state.history[i];
        if (hist && hist.correct) progress += '✅ ';
        else if (hist && !hist.correct) progress += '❌ ';
        else progress += '▪ ';
      } else {
        progress += '▪ ';
      }
    }
    ui.progress.textContent = progress.trim();

    ui.gameOver.style.display = 'none';
    ui.input.focus();
  }

  // ===== POSER UNE QUESTION =====
  function askQuestion(){
    if (state.suspectAnswered || state.gameOver) return;
    if (state.questionCount >= state.maxQuestions) {
      ui.qText.textContent = "Vous avez posé toutes vos questions. Décidez maintenant !";
      ui.aText.textContent = "";
      return;
    }

    const question = ui.input.value.trim();
    if (question === "") {
      ui.aText.textContent = "⚠️ Veuillez saisir une question.";
      return;
    }

    const acc = state.currentSuspect.accusation;
    const answer = generateAnswer(
      state.currentSuspect.guilty,
      question,
      acc.crime,
      acc.victime
    );
    state.questionCount++;

    // Log
    const entry = document.createElement('div');
    entry.className = 'entry';
    entry.innerHTML = `<span class="q">❓ ${question}</span> → <span class="a">"${answer}"</span>`;
    ui.log.appendChild(entry);
    ui.log.scrollTop = ui.log.scrollHeight;

    ui.qText.textContent = "Dernière question posée :";
    ui.aText.textContent = `🔊 "${answer}"`;
    ui.qcount.textContent = `${state.questionCount}/${state.maxQuestions}`;
    ui.input.value = '';
    ui.input.focus();

    SoundEngine.playFX('click');

    if (state.questionCount >= state.maxQuestions) {
      ui.qText.textContent = "Vous avez posé toutes vos questions. Décidez du sort du suspect.";
      ui.input.disabled = true;
      ui.btnAsk.disabled = true;
      ui.btnPrison.disabled = false;
      ui.btnRelease.disabled = false;
    }
  }

  // ===== JUGER =====
  function judge(prison){
    if (state.suspectAnswered || state.gameOver) return;
    if (state.questionCount < state.maxQuestions) {
      if (!confirm(`Vous n'avez posé que ${state.questionCount}/${state.maxQuestions} questions. Voulez-vous vraiment juger maintenant ?`)) {
        return;
      }
    }

    state.suspectAnswered = true;
    const guilty = state.currentSuspect.guilty;
    const correct = (prison === guilty);

    ui.feedback.style.display = 'block';
    if (correct) {
      ui.feedback.textContent = `✅ JUSTICE ! Le suspect était ${guilty ? 'coupable' : 'innocent'}. Bonne décision !`;
      ui.feedback.style.borderColor = '#14b8a6';
      state.score++;
      SoundEngine.playFX('correct');
      spawnParticles('particle-container-dictator', 15, '#14b8a6');
    } else {
      ui.feedback.textContent = `❌ ERREUR ! Le suspect était ${guilty ? 'coupable' : 'innocent'}. Vous avez commis une injustice.`;
      ui.feedback.style.borderColor = '#ef4444';
      SoundEngine.playFX('wrong');
      spawnParticles('particle-container-dictator', 15, '#ef4444');
    }

    ui.score.textContent = state.score;
    state.history.push({
      name: state.currentSuspect.name,
      guilty: guilty,
      decision: prison ? 'prison' : 'liberation',
      correct: correct
    });

    ui.btnPrison.disabled = true;
    ui.btnRelease.disabled = true;
    ui.input.disabled = true;
    ui.btnAsk.disabled = true;

    ui.nextBtn.style.display = 'inline-block';
    ui.nextBtn.textContent = state.currentIndex < state.suspects.length - 1 ? 'SUSPECT SUIVANT ▶' : '🏁 VOIR LE RÉSULTAT';
  }

  // ===== SUSPECT SUIVANT =====
  function next(){
    if (state.gameOver) return;
    state.currentIndex++;
    if (state.currentIndex >= state.suspects.length) {
      endGame();
    } else {
      displaySuspect();
    }
  }

  // ===== FIN DE PARTIE =====
  function endGame(){
    state.gameOver = true;
    const total = state.suspects.length;
    const score = state.score;
    const pct = Math.round((score / total) * 100);

    ui.gameOver.style.display = 'flex';
    ui.goTitle.textContent = pct >= 80 ? '🏆 INTERROGATEUR D\'EXCEPTION !' : '📋 INTERROGATION TERMINÉE';
    ui.goDesc.textContent = `Vous avez jugé ${score}/${total} suspects correctement (${pct}%).`;
    if (pct >= 80) {
      ui.goDesc.textContent += ' La justice est rendue !';
      SoundEngine.playFX('victory');
      spawnParticles('particle-container-dictator', 30, '#14b8a6');
    } else if (pct >= 50) {
      ui.goDesc.textContent += ' Pas mal, mais vous pouvez mieux faire.';
    } else {
      ui.goDesc.textContent += ' Vous avez un sens de la justice à revoir.';
      SoundEngine.playFX('error');
    }

    let logHtml = '';
    state.history.forEach((h, i) => {
      const icon = h.correct ? '✅' : '❌';
      const decision = h.decision === 'prison' ? '🔒 Prison' : '🔓 Libéré';
      const real = h.guilty ? '🔒 Coupable' : '🔓 Innocent';
      logHtml += `• ${i+1}. ${h.name} → ${real} (vous: ${decision}) ${icon}<br>`;
    });
    ui.goLog.innerHTML = logHtml;

    const name = prompt('Entrez votre nom pour le classement:', 'Enquêteur') || 'Anonyme';
    HighScores.add(score, name, 'interro');
  }

  // ===== REDÉMARRAGE =====
  function restart(){
    prepareSuspects();
    displaySuspect();
    ui.gameOver.style.display = 'none';
    ui.nextBtn.style.display = 'none';
    ui.feedback.style.display = 'none';
  }

  // ===== INIT =====
  function init(){
    prepareSuspects();
    displaySuspect();
    ui.gameOver.style.display = 'none';
    ui.nextBtn.style.display = 'none';
    ui.feedback.style.display = 'none';

    document.getElementById('interro-input').addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        askQuestion();
      }
    });
  }

  return { askQuestion, judge, next, restart, init };
})();


// ============================================================
//  SWITCH GAME
// ============================================================
function switchGame(game){
  document.querySelectorAll('.game-container').forEach(c => c.classList.remove('active'));
  document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));

  if (game === 'dictator') {
    document.getElementById('game-dictator').classList.add('active');
    document.getElementById('nav-dictator').classList.add('active');
  } else if (game === 'sioniste') {
    document.getElementById('game-sioniste').classList.add('active');
    document.getElementById('nav-sioniste').classList.add('active');
    SionisteGame.init();
  } else if (game === 'interrogation') {
    document.getElementById('game-interrogation').classList.add('active');
    document.getElementById('nav-interrogation').classList.add('active');
    InterrogationGame.init();
  }
}

// ============================================================
//  LANCEMENT
// ============================================================
window.addEventListener('DOMContentLoaded', ()=>{
  PresidentEngine.init();
  SionisteGame.init();
  InterrogationGame.init();
  SoundEngine.init();
  console.log('🏆 High scores:', HighScores.get());
});
