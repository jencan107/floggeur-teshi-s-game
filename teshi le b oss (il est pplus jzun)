// ============================================================
//  SOUND ENGINE (global)
// ============================================================
const SoundEngine = {
  ctx: null,
  init(){ if(!this.ctx){ this.ctx=new(window.AudioContext||window.webkitAudioContext)(); } if(this.ctx.state==='suspended') this.ctx.resume(); },
  playTone(f,d=0.2,t='square',g=0.3,s=null){
    this.init(); const o=this.ctx.createOscillator(),gn=this.ctx.createGain(),now=this.ctx.currentTime;
    o.type=t; o.frequency.setValueAtTime(f,now); if(s) o.frequency.exponentialRampToValueAtTime(Math.max(s,10),now+d);
    gn.gain.setValueAtTime(g,now); gn.gain.exponentialRampToValueAtTime(0.001,now+d);
    o.connect(gn); gn.connect(this.ctx.destination); o.start(now); o.stop(now+d);
  },
  playFX(type){
    try{
      switch(type){
        case 'click': this.playTone(400,'square',0.05,0.1,200); break;
        case 'victory': this.playTone(261,'square',0.15,0.3); setTimeout(()=>this.playTone(329,'square',0.15,0.3),150); setTimeout(()=>this.playTone(392,'square',0.15,0.3),300); setTimeout(()=>this.playTone(523,'square',0.4,0.4),450); break;
        case 'error': this.playTone(200,'sawtooth',0.4,0.4,80); break;
        case 'correct': this.playTone(587,'sine',0.1,0.3,880); break;
        case 'wrong': this.playTone(220,'sawtooth',0.2,0.3,110); break;
        case 'prison': this.playTone(150,'sawtooth',0.3,0.4,80); break;
        case 'release': this.playTone(440,'sine',0.1,0.3,880); break;
        default: break;
      }
    } catch(e){}
  }
};

